{
  "name": "metaflora-neuro-crm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "catalog:generate": "node scripts/generate-product-catalog.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "start": "node server/start.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run src/App.test.jsx",
    "test:server": "node --test server/*.test.js",
    "test:server:coverage": "node --test --experimental-test-coverage server/*.test.js",
    "test:all": "npm test && npm run test:server:coverage && npm run build && npm run test:sites",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "playwright": "1.62.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.10"
  }
}
